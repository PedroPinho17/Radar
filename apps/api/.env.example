PORT=3001
DATABASE_URL=postgres://radar:radar@127.0.0.1:5434/radar
NODE_ENV=development
GEMINI_API_KEY=tua_chave
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
ITJOBS_API_KEY=tua_chave
GROQ_API_KEY=a_tua_chave
GROQ_MODEL=openai/gpt-oss-120b
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=teu@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="Radar <teu@gmail.com>"
# URL do site (links nos emails e origem permitida para POST/PUT)
WEB_URL=http://localhost:3000
# Outras origens permitidas, separadas por vírgulas (opcional)
# ALLOWED_ORIGINS=https://radar.exemplo.pt
# A API só escuta em 127.0.0.1 por omissão. Num servidor com a API noutra máquina/contentor: HOST=0.0.0.0
# HOST=127.0.0.1
# Proxy de confiança para ler o IP real (X-Forwarded-For). Por omissão: loopback (o Next no mesmo PC)
# TRUST_PROXY=loopback

# Jooble: ofertas de todas as áreas (chave gratuita em https://jooble.org/api/about). Opcional.
# JOOBLE_API_KEY=

# Monitorização
# ALERT_EMAIL=quem-recebe-alertas@exemplo.pt   (fontes em baixo, IA ou resumos a falhar)
# ADMIN_EMAILS=o-teu-email@exemplo.pt          (acesso à página /estado)

# Salário estimado (opcional): serviço Python salary-predictor. Sem isto, simplesmente não aparece estimativa.
# SALARY_API_URL=http://127.0.0.1:8000
